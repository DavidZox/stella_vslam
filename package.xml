<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
    <name>stella_vslam</name>
    <version>0.7.0</version>
    <description>fork of OpenVSLAM</description>

    <!-- Authors of the original version of OpenVSLAM -->
    <author>Shinya Sumikura</author>
    <author>Mikiya Shibuya</author>
    <author>Ken Sakurada</author>
    <!-- Author/maintainer of the stella_vslam (fork version of OpenVSLAM) -->
    <author>ymd-stella</author>
    <maintainer email="world.applepie@gmail.com">ymd-stella</maintainer>

    <license>2-clause BSD</license>
    <url type="website">https://stella.readthedocs.io/</url>

    <buildtool_depend>cmake</buildtool_depend>

    <depend>eigen</depend>
    <!-- Upstream lists libg2o here (a rosdep/apt key), assuming g2o comes from a system package.
         We build g2o from source as a sibling colcon package instead (Ubuntu's libg2o-dev has no
         CMake config exports, see main VSLAM_package README "已知眉角"), so this points at that
         package name instead so colcon orders the workspace build correctly. -->
    <depend>g2o</depend>
    <depend>libopencv-dev</depend>
    <depend>yaml-cpp</depend>
    <depend>libsqlite3-dev</depend>

    <export>
        <build_type>cmake</build_type>
    </export>
</package>
